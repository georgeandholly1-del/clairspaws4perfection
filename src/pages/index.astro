---
import "../styles/global.css";
import "../styles/homepage.css";

const businessName = "Clairs Paws 4 Perfection";
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{businessName} | Dog Grooming</title>
	</head>

	<body>
		<header>
			<h1 class="heading">{businessName}.</h1>
			<p>DOG GROOMING · CHADDERTON</p>
		</header>

		<nav class="navigation">
			<a href="/">HOME</a>
			<a href="/gallery">GALLERY</a>
			<a href="/booking">BOOK</a>
		</nav>

		<main class="main">
			<img
				src="/images/websiteBanner.jpeg"
				alt="Dog grooming at Paws & Co."
			/>

			<section class="about">
				<h2>A little more love. A little less fluff.</h2>

				<p>
					Based in Chadderton, our stylist Clair has extensive
					experience and a passion for making every dog feel
					comfortable and cared for. Your furry friend deserves
					nothing but the very best treatment.
				</p>

				<a href="/booking" class="book-button"> BOOK AN APPOINTMENT </a>
			</section>
		</main>

		<footer>
			<p>{businessName} · CHADDERTON</p>
		</footer>
		```
	</body>
</html>
