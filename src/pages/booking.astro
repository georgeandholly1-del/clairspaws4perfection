---
import "../styles/global.css";
import "../styles/homepage.css";
import "../styles/booking.css";

const businessName = "Clairs Paws 4 Perfection";
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Book an Appointment | {businessName}</title>
    </head>

    <body>
        <header>
            <h1 class="heading">{businessName}.</h1>
            <p>DOG GROOMING · CHADDERTON</p>
        </header>

        <nav class="navigation">
            <a href="/">HOME</a>
            <a href="/gallery">GALLERY</a>
            <a href="/booking">BOOK</a>
        </nav>

        <main class="booking-main">
            <section class="booking-intro">
                <p class="eyebrow">LET'S GET YOUR DOG PAMPERED</p>
                <h2>Book an appointment.</h2>
                <p>
                    Choose a date and time that works for you. We look forward
                    to welcoming your furry friend.
                </p>
            </section>

            <form id="booking-form" class="booking-form">
                <section class="booking-section">
                    <div class="section-heading">
                        <span>01</span>
                        <h3>Choose a date</h3>
                    </div>

                    <label for="booking-date">Appointment date</label>
                    <input type="date" id="booking-date" name="date" required />

                    <p class="field-hint">
                        Monday–Thursday and Saturdays only.
                    </p>
                </section>

                <section class="booking-section">
                    <div class="section-heading">
                        <span>02</span>
                        <h3>Choose a time</h3>
                    </div>

                    <div id="time-slots" class="time-slots">
                        <p class="field-hint">Please select a date first.</p>
                    </div>

                    <input
                        type="hidden"
                        name="time"
                        id="selected-time"
                        required
                    />
                </section>

                <section class="booking-section">
                    <div class="section-heading">
                        <span>03</span>
                        <h3>Your details</h3>
                    </div>

                    <div class="form-grid">
                        <div class="form-field">
                            <label for="owner-name">Your name</label>
                            <input
                                type="text"
                                id="owner-name"
                                name="owner"
                                placeholder="Full name"
                                required
                            />
                        </div>

                        <div class="form-field">
                            <label for="phone">Phone number</label>
                            <input
                                type="tel"
                                id="phone"
                                name="phone"
                                placeholder="Your phone number"
                                required
                            />
                        </div>

                        <div class="form-field full-width">
                            <label for="email">Email address</label>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="you@example.com"
                                required
                            />
                        </div>
                    </div>

                </section>

                <section class="booking-section">
                    <div class="section-heading">
                        <span>04</span>
                        <h3>About your dog</h3>
                    </div>

                    <div class="form-grid">
                        <div class="form-field">
                            <label for="dog-name">Dog's name</label>
                            <input
                                type="text"
                                id="dog-name"
                                name="dog"
                                placeholder="Your dog's name"
                                required
                            />
                        </div>

                        <div class="form-field">
                            <label for="breed">Breed</label>
                            <input
                                type="text"
                                id="breed"
                                name="breed"
                                placeholder="e.g. Cockapoo"
                                required
                            />
                        </div>

                        <div class="form-field full-width">
                            <label for="size">Dog's size</label>
                            <select id="size" name="size" required>
                                <option value="">Select size</option>
                                <option value="Small">Small</option>
                                <option value="Medium">Medium</option>
                                <option value="Large">Large</option>
                            </select>
                        </div>
                    </div>
                </section>

                <section class="deposit-section">
                    <div>
                        <p class="eyebrow">SECURE YOUR APPOINTMENT</p>
                        <h3>Booking deposit</h3>
                        <p>A £1 deposit is required to secure your booking.</p>
                    </div>

                    <span class="deposit-price">£1.00</span>
                </section>

                <button type="submit" class="booking-submit">
                    Continue to payment →
                </button>

                <p class="booking-disclaimer">
                    Your appointment is not confirmed until payment has been
                    completed and availability verified.
                </p>

                <p id="booking-message" role="status"></p>
            </form>
        </main>

        <footer>
            <p>{businessName} · CHADDERTON</p>
        </footer>

        <script>
            const dateInput = document.querySelector("#booking-date");
            const timeSlots = document.querySelector("#time-slots");
            const selectedTime = document.querySelector("#selected-time");
            const bookingForm = document.querySelector("#booking-form");
            const message = document.querySelector("#booking-message");

            // Set minimum date to today using local time
            const today = new Date();

            const localToday = new Date(
                today.getTime() - today.getTimezoneOffset() * 60000,
            )
                .toISOString()
                .split("T")[0];

            dateInput.min = localToday;

            // Fetch available appointment slots
            dateInput.addEventListener("change", async () => {
                timeSlots.innerHTML = "";
                selectedTime.value = "";
                message.textContent = "";

                if (!dateInput.value) return;

                timeSlots.innerHTML =
                    "<p class='field-hint'>Checking availability...</p>";

                try {
                    const response = await fetch(
                        `/api/availability?date=${encodeURIComponent(dateInput.value)}`,
                    );

                    const result = await response.json();

                    if (!response.ok) {
                        throw new Error(
                            result.error || "Unable to check availability.",
                        );
                    }

                    if (result.slots.length === 0) {
                        timeSlots.innerHTML =
                            "<p class='field-hint'>Sorry, we are closed on this day. Please choose another date.</p>";
                        return;
                    }

                    result.slots.forEach((slot) => {
                        const button = document.createElement("button");

                        button.type = "button";
                        button.className = "time-slot";
                        button.textContent = slot.available
                            ? slot.time
                            : `${slot.time} — Unavailable`;

                        button.disabled = !slot.available;

                        button.addEventListener("click", () => {
                            document
                                .querySelectorAll(".time-slot")
                                .forEach((item) => {
                                    item.classList.remove("selected");
                                });

                            button.classList.add("selected");
                            selectedTime.value = slot.time;
                        });

                        timeSlots.appendChild(button);
                    });
                } catch (error) {
                    console.error("Availability error:", error);

                    timeSlots.innerHTML =
                        "<p class='field-hint'>Unable to check availability. Please try again.</p>";
                }
            });

            // Submit booking and create Stripe Checkout session
            bookingForm.addEventListener("submit", async (event) => {
                event.preventDefault();

                message.textContent = "";

                if (!selectedTime.value) {
                    message.textContent = "Please select an appointment time.";
                    return;
                }

                const submitButton = bookingForm.querySelector(
                    'button[type="submit"]',
                );

                submitButton.disabled = true;
                submitButton.textContent = "Preparing payment...";

                try {
                    const formData = new FormData(bookingForm);

                    const bookingDetails = Object.fromEntries(
                        formData.entries(),
                    );

                    const response = await fetch("/api/book", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify(bookingDetails),
                    });

                    const result = await response.json();

                    if (!response.ok) {
                        throw new Error(
                            result.error || "Unable to create your booking.",
                        );
                    }

                    if (!result.checkoutUrl) {
                        throw new Error("Payment link was not returned.");
                    }

                    // Redirect customer to Stripe Checkout
                    window.location.href = result.checkoutUrl;
                } catch (error) {
                    console.error("Booking submission failed:", error);

                    message.textContent =
                        error instanceof Error
                            ? error.message
                            : "Something went wrong. Please try again.";

                    submitButton.disabled = false;
                    submitButton.textContent = "Continue to payment →";
                }
            });
        </script>
    </body>
</html>
